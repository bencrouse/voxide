include("${CMAKE_CURRENT_LIST_DIR}/PrepareJuce.cmake")
set(JUCE_DIR "" CACHE PATH "Explicit clean matching JUCE Git checkout")
set(VOXIDE_DEPENDENCY_CACHE "${PROJECT_SOURCE_DIR}/.cache/dependencies" CACHE PATH "Verified dependency archive cache")
set(VOXIDE_JUCE_ARCHIVE "" CACHE FILEPATH "Explicit checksum-matching JUCE archive")
option(VOXIDE_OFFLINE "Never download dependencies" OFF)

if(JUCE_DIR)
    voxide_verify_checkout("${JUCE_DIR}")
    add_subdirectory("${JUCE_DIR}" "${PROJECT_BINARY_DIR}/_deps/juce-build")
else()
    if(NOT VOXIDE_JUCE_ARCHIVE)
        set(VOXIDE_JUCE_ARCHIVE "${VOXIDE_DEPENDENCY_CACHE}/juce-${VOXIDE_JUCE_REVISION}.tar.gz")
        if(NOT EXISTS "${VOXIDE_JUCE_ARCHIVE}")
            if(VOXIDE_OFFLINE)
                message(FATAL_ERROR "Offline JUCE archive missing: ${VOXIDE_JUCE_ARCHIVE}")
            endif()
            voxide_download_juce("${VOXIDE_JUCE_ARCHIVE}" "${VOXIDE_DEPENDENCY_CACHE}")
        endif()
    endif()
    voxide_prepare_juce("${VOXIDE_JUCE_ARCHIVE}" "${PROJECT_BINARY_DIR}/_deps" juce_source)
    add_subdirectory("${juce_source}" "${PROJECT_BINARY_DIR}/_deps/juce-build")
endif()
message(STATUS "Voxide: JUCE 8.0.15 / ${VOXIDE_JUCE_REVISION}, AGPLv3 local-only use")
