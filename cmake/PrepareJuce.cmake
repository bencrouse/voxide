include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/VerifyDependency.cmake")

function(voxide_source_digest directory output)
    if(IS_SYMLINK "${directory}")
        message(FATAL_ERROR "Refusing symlink JUCE source: ${directory}")
    endif()
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${directory}" "${directory}/*")
    list(SORT entries)
    set(manifest "")
    foreach(entry IN LISTS entries)
        set(path "${directory}/${entry}")
        if(IS_SYMLINK "${path}")
            message(FATAL_ERROR "Refusing symlink in JUCE source: ${path}")
        elseif(IS_DIRECTORY "${path}")
            string(APPEND manifest "directory|${entry}\n")
        else()
            file(SHA256 "${path}" digest)
            string(APPEND manifest "file|${entry}|${digest}\n")
        endif()
    endforeach()
    string(SHA256 tree_digest "${manifest}")
    set(${output} "${tree_digest}" PARENT_SCOPE)
endfunction()

function(voxide_prepare_juce archive dependencies output)
    voxide_verify_archive("${archive}")
    if(IS_SYMLINK "${dependencies}")
        message(FATAL_ERROR "Refusing symlink dependency directory")
    endif()
    file(MAKE_DIRECTORY "${dependencies}")
    file(LOCK "${dependencies}/juce-source.lock" GUARD FUNCTION TIMEOUT 120)
    set(source "${dependencies}/JUCE-${VOXIDE_JUCE_REVISION}")
    set(stamp "${dependencies}/juce-source.sha256")
    if(IS_SYMLINK "${source}" OR IS_SYMLINK "${stamp}")
        message(FATAL_ERROR "Refusing symlink JUCE source or manifest")
    endif()
    if(NOT EXISTS "${stamp}")
        # Canonical content comes from the verified archive, not the existing tree.
        # This also adopts an older pristine bootstrap tree without overwriting edits.
        string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
        set(stage "${dependencies}/juce-verify-${nonce}")
        if(EXISTS "${stage}")
            message(FATAL_ERROR "Dependency verification stage already exists")
        endif()
        file(MAKE_DIRECTORY "${stage}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}")
        set(canonical "${stage}/JUCE-${VOXIDE_JUCE_REVISION}")
        if(NOT EXISTS "${canonical}/CMakeLists.txt")
            message(FATAL_ERROR "Verified archive has an unexpected source layout")
        endif()
        voxide_source_digest("${canonical}" expected)
        if(EXISTS "${source}")
            voxide_source_digest("${source}" actual)
            if(NOT actual STREQUAL expected)
                file(REMOVE_RECURSE "${stage}") # Only the unique stage created above.
                message(FATAL_ERROR "JUCE extracted source mismatch; edits preserved. Use a fresh build directory.")
            endif()
        else()
            file(RENAME "${canonical}" "${source}")
        endif()
        file(WRITE "${stamp}" "${VOXIDE_JUCE_SHA256}\n${expected}\n")
        file(REMOVE_RECURSE "${stage}") # Only our canonical extraction stage.
    endif()
    file(STRINGS "${stamp}" recorded)
    list(LENGTH recorded count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Invalid JUCE source manifest; use a fresh build directory")
    endif()
    list(GET recorded 0 archive_digest)
    list(GET recorded 1 expected)
    voxide_source_digest("${source}" actual)
    if(NOT archive_digest STREQUAL VOXIDE_JUCE_SHA256 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "JUCE extracted source mismatch; edits preserved. Use a fresh build directory.")
    endif()
    set(${output} "${source}" PARENT_SCOPE)
endfunction()

function(voxide_download_juce archive cache)
    file(MAKE_DIRECTORY "${cache}")
    file(LOCK "${cache}/juce-download.lock" GUARD FUNCTION TIMEOUT 120)
    if(EXISTS "${archive}")
        return()
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(download "${archive}.${nonce}.download")
    file(DOWNLOAD "https://codeload.github.com/juce-framework/JUCE/tar.gz/${VOXIDE_JUCE_REVISION}"
        "${download}" TLS_VERIFY ON STATUS download_status)
    list(GET download_status 0 code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "JUCE download failed: ${download_status}")
    endif()
    voxide_verify_archive("${download}")
    file(RENAME "${download}" "${archive}")
endfunction()
